generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum DocumentCategory {
  CONTRACT
  INVOICE
  REPORT
  CERTIFICATE
  OTHER
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  documents Document[]
}

model Document {
  id          Int              @id @default(autoincrement())
  name        String
  description String?
  category    DocumentCategory
  fileUrl  String?
  publicId String?
  fileName String?
  fileType String?
  fileSize Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
